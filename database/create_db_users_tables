USE optimizer_data;

CREATE TABLE `context` (
  `id` BIGINT UNSIGNED NOT NULL,              -- CRM note id
  `deal_id` BIGINT UNSIGNED NOT NULL,
  `created_at` BIGINT UNSIGNED NOT NULL,
  `updated_at` BIGINT UNSIGNED NOT NULL,
  `note_type` VARCHAR(30) NOT NULL,
  `payload` LONGTEXT NULL,

  `processed_ok` TINYINT(1) NOT NULL DEFAULT 1,   -- новый флаг 0/1

  PRIMARY KEY (`id`),
  KEY `idx_context_deal_id` (`deal_id`),
  KEY `idx_context_deal_time` (`deal_id`, `created_at`)
) ENGINE=InnoDB
  DEFAULT CHARSET=utf8mb4
  COLLATE=utf8mb4_unicode_ci;


CREATE TABLE `results` (
  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
  `deal_id` BIGINT UNSIGNED NOT NULL,
  `created_at` BIGINT UNSIGNED NOT NULL,
  `updated_at` BIGINT UNSIGNED NOT NULL,
  `type` VARCHAR(30) NOT NULL,
  `llm_result` LONGTEXT NULL,

  PRIMARY KEY (`id`),
  KEY `idx_results_deal_id` (`deal_id`),
  KEY `idx_results_deal_time` (`deal_id`, `created_at`)
) ENGINE=InnoDB
  DEFAULT CHARSET=utf8mb4
  COLLATE=utf8mb4_unicode_ci;


USE optimizer_data;

CREATE TABLE `prompt` (
  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
  `system_prompt` LONGTEXT NULL,

  PRIMARY KEY (`id`)
) ENGINE=InnoDB
  DEFAULT CHARSET=utf8mb4
  COLLATE=utf8mb4_unicode_ci;

CREATE TABLE `deal_processing_locks` (
  `deal_id` BIGINT UNSIGNED NOT NULL,
  `locked_at` TIMESTAMP,

  PRIMARY KEY (`deal_id`)
) ENGINE=InnoDB
  DEFAULT CHARSET=utf8mb4
  COLLATE=utf8mb4_unicode_ci;